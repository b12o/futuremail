# Database
DATABASE_URL=file:./data/futuremail.db
# Managed instance can instead use:
# DATABASE_URL=libsql://<turso-host>?authToken=<token>
# Apply drizzle migrations automatically on app boot / dispatcher start.
# Leave unset while prototyping (use `bun run db:push` instead).
# Set to true in production, or run `bun run db:migrate` manually.
# DB_AUTO_MIGRATE=true

# Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me

# Dispatcher
POLL_INTERVAL_MS=60000
CLAIM_BATCH_SIZE=25
JOB_RETRY_COUNT=3
# A row claimed for sending is released back to pending after this long, so an
# unexpectedly killed dispatcher cannot strand it in "sending" forever.
CLAIM_TIMEOUT_MS=300000

# Email provider: set RESEND_API_KEY for Resend, or SMTP_* for SMTP.
# In development, with neither set, emails are logged to the console.
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Email sender identity
EMAIL_FROM=FutureMail <no-reply@futuremail.local>
